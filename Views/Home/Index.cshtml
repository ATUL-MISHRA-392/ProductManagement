@{
    ViewData["Title"] = "Dashboard";
}

<div class="row align-items-center py-4 mb-4">
    <div class="col-lg-8">
        <h1 class="display-6 fw-bold text-dark mb-2">Welcome to Product Management System</h1>
        <p class="lead text-muted mb-4">
            A comprehensive solution for tracking products, managing catalog categories, monitoring stock levels, and maintaining pricing data.
        </p>
        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="Products" asp-action="Index" class="btn btn-primary px-4 py-2 shadow-sm">
                View All Products &rarr;
            </a>
            <a asp-controller="Products" asp-action="Create" class="btn btn-outline-primary px-4 py-2">
                + Add New Product
            </a>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm rounded-3 p-4 bg-white">
            <div class="fs-1 mb-2 text-primary">📦</div>
            <h5 class="fw-bold">Product Catalog</h5>
            <p class="text-muted small">Manage items, update product details, categories, descriptions, and uploaded images seamlessly.</p>
            <a asp-controller="Products" asp-action="Index" class="text-decoration-none fw-semibold small mt-auto">Go to Catalog &rarr;</a>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm rounded-3 p-4 bg-white">
            <div class="fs-1 mb-2 text-success">📊</div>
            <h5 class="fw-bold">Inventory & Stock</h5>
            <p class="text-muted small">Real-time indicators for in-stock, low-stock, and out-of-stock items to keep your inventory healthy.</p>
            <a asp-controller="Products" asp-action="Index" class="text-decoration-none fw-semibold small mt-auto">Check Stock &rarr;</a>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm rounded-3 p-4 bg-white">
            <div class="fs-1 mb-2 text-warning">✨</div>
            <h5 class="fw-bold">Easy Management</h5>
            <p class="text-muted small">Quickly create, update pricing, and safely delete obsolete records with full data validation.</p>
            <a asp-controller="Products" asp-action="Create" class="text-decoration-none fw-semibold small mt-auto">Create Product &rarr;</a>
        </div>
    </div>
</div>
