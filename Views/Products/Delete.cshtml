@model ProductManagementSystem.Models.Product

@{
    ViewData["Title"] = "Delete Product";
}

<div class="row justify-content-center">
    <div class="col-lg-6 col-md-8">
        <div class="card shadow border-0 rounded-3 border-top border-4 border-danger">
            <div class="card-body p-4 text-center">
                <div class="mb-3 text-danger">
                    <svg xmlns="http://www.w3.org/2000/svg" width="56" height="56" fill="currentColor" class="bi bi-exclamation-triangle" viewBox="0 0 16 16">
                        <path d="M7.938 2.016A.13.13 0 0 1 8.002 2a.13.13 0 0 1 .063.016.15.15 0 0 1 .054.057l6.857 11.667c.036.06.035.124.002.183a.2.2 0 0 1-.054.06.1.1 0 0 1-.066.017H1.146a.1.1 0 0 1-.066-.017.2.2 0 0 1-.054-.06.18.18 0 0 1 .002-.183L7.884 2.073a.15.15 0 0 1 .054-.057zm1.044-.45a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767z"/>
                        <path d="M7.002 12a1 1 0 1 1 2 0 1 1 0 0 1-2 0M7.1 5.995a.905.905 0 1 1 1.8 0l-.35 3.507a.552.552 0 0 1-1.1 0z"/>
                    </svg>
                </div>

                <h2 class="h4 mb-2 text-danger fw-bold">Delete Confirmation</h2>
                <p class="text-muted mb-4">Are you sure you want to delete this product? This action cannot be undone.</p>

                <div class="card bg-light border-0 rounded-3 p-3 text-start mb-4">
                    <div class="d-flex align-items-center gap-3">
                        @if (!string.IsNullOrEmpty(Model.ImagePath))
                        {
                            <img src="@Model.ImagePath" alt="@Model.Name" class="rounded border" style="width: 70px; height: 70px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="border rounded bg-white text-muted d-flex align-items-center justify-content-center" style="width: 70px; height: 70px;">
                                <span class="small">No image</span>
                            </div>
                        }

                        <div>
                            <h5 class="mb-1 fw-bold text-dark">@Model.Name</h5>
                            <span class="badge bg-secondary mb-2">@Model.Category</span>
                            <div class="text-muted small">
                                <span class="me-3"><strong>Price:</strong> ₹@Model.Price.ToString("N2")</span>
                                <span><strong>Stock:</strong> @Model.Stock units</span>
                            </div>
                            @if (!string.IsNullOrEmpty(Model.Description))
                            {
                                <p class="text-muted small mt-2 mb-0">@Model.Description</p>
                            }
                        </div>
                    </div>
                </div>

                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    
                    <div class="d-flex justify-content-center gap-2">
                        <button type="submit" class="btn btn-danger px-4">
                            Yes, Delete Product
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
