@model ProductManagementSystem.Models.Product

@{
    ViewData["Title"] = "Edit Product";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="h3 mb-1 text-primary">Edit Product</h1>
                <p class="text-muted small mb-0">Update the product information and inventory details.</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                &larr; Back to Products
            </a>
        </div>

        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-body p-4">
                <form asp-action="Edit" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="ImagePath" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold">Product Name <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" placeholder="Enter product name" required />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Price" class="form-label fw-semibold">Price (₹) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text">₹</span>
                                <input asp-for="Price" class="form-control" type="number" step="0.01" min="0.01" required />
                            </div>
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Category" class="form-label fw-semibold">Category <span class="text-danger">*</span></label>
                            <input asp-for="Category" class="form-control" placeholder="e.g. Electronics, Clothing" required />
                            <span asp-validation-for="Category" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Stock" class="form-label fw-semibold">Stock Quantity <span class="text-danger">*</span></label>
                        <input asp-for="Stock" class="form-control" type="number" min="0" required />
                        <span asp-validation-for="Stock" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Enter product details, specifications..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Product Image</label>
                        <div class="d-flex align-items-center gap-3 mb-2">
                            <div class="image-preview-wrapper border rounded p-1 bg-light d-flex align-items-center justify-content-center" style="width: 90px; height: 90px;">
                                @if (!string.IsNullOrEmpty(Model.ImagePath))
                                {
                                    <img id="previewImg" src="@Model.ImagePath" alt="@Model.Name" class="rounded" style="max-width: 100%; max-height: 100%; object-fit: cover;" />
                                }
                                else
                                {
                                    <img id="previewImg" src="#" alt="Preview" class="rounded d-none" style="max-width: 100%; max-height: 100%; object-fit: cover;" />
                                    <span id="noImgText" class="text-muted small">No Image</span>
                                }
                            </div>
                            <div class="flex-grow-1">
                                <input type="file" id="imageFile" name="imageFile" class="form-control" accept=".jpg,.jpeg,.png,.webp" onchange="previewSelectedImage(this)" />
                                <small class="text-muted d-block mt-1">Upload a new image to replace current (JPG, PNG or WEBP; max 5MB).</small>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 pt-2 border-top">
                        <button type="submit" class="btn btn-primary px-4">
                            Save Changes
                        </button>
                        <a asp-action="Index" class="btn btn-light px-4 border">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function previewSelectedImage(input) {
            const preview = document.getElementById('previewImg');
            const noImg = document.getElementById('noImgText');
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    preview.src = e.target.result;
                    preview.classList.remove('d-none');
                    if (noImg) noImg.classList.add('d-none');
                }
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}
